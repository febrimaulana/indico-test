# Copy this file to .env only if you need to override the defaults.
# docker compose up works without any .env file.

# --- Database ---
POSTGRES_USER=indico
POSTGRES_PASSWORD=indico
POSTGRES_DB=indico
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=8080
DATABASE_URL=postgres://indico:indico@localhost:5433/indico?sslmode=disable
LOG_LEVEL=info
EXPIRY_DURATION=5m
SWEEP_INTERVAL=15s
SWEEP_BATCH_SIZE=500
SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=*
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY=1s

# --- Frontend ---
FRONTEND_PORT=3000
