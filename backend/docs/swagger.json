{
    "swagger": "2.0",
    "info": {
        "description": "High-throughput inventory reservation system. Reservasi stok otomatis kedaluwarsa dalam 5 menit jika tidak dikonfirmasi.",
        "title": "INDICO Inventory Reservation API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/inventory/confirm": {
            "post": {
                "description": "Mengubah reservasi aktif menjadi permanen dan mengurangi stok fisik. Reservasi yang sudah kedaluwarsa atau sudah dikonfirmasi akan ditolak.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Konfirmasi reservasi",
                "parameters": [
                    {
                        "description": "Payload konfirmasi",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_modules_inventory.ConfirmRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_modules_inventory.ConfirmResponse"
                        }
                    },
                    "400": {
                        "description": "Input tidak valid",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Reservasi tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Reservasi sudah dikonfirmasi",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "410": {
                        "description": "Reservasi sudah kedaluwarsa",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Kesalahan internal",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/inventory/reserve": {
            "post": {
                "description": "Mengunci stok secara atomik untuk seorang user. Reservasi otomatis kedaluwarsa dalam 5 menit jika tidak dikonfirmasi.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Reservasi stok item",
                "parameters": [
                    {
                        "description": "Payload reservasi",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_modules_inventory.ReserveRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_modules_inventory.ReserveResponse"
                        }
                    },
                    "400": {
                        "description": "Input tidak valid",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Item tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Stok tidak mencukupi",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Kesalahan internal",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/inventory/stock": {
            "get": {
                "description": "Menampilkan rincian stok real-time: total, yang sedang direservasi, dan yang tersedia.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Status stok item",
                "parameters": [
                    {
                        "type": "string",
                        "example": "item_4021",
                        "description": "ID item",
                        "name": "item_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_modules_inventory.StockResponse"
                        }
                    },
                    "400": {
                        "description": "Parameter tidak valid",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Item tidak ditemukan",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Kesalahan internal",
                        "schema": {
                            "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "indico_backend_internal_platform_httpx.ErrorDetail": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "quantity"
                },
                "message": {
                    "type": "string",
                    "example": "quantity harus lebih dari 0"
                },
                "rule": {
                    "type": "string",
                    "example": "gt"
                }
            }
        },
        "indico_backend_internal_platform_httpx.ErrorInfo": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "INSUFFICIENT_STOCK"
                },
                "details": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorDetail"
                    }
                },
                "message": {
                    "type": "string",
                    "example": "stok tidak mencukupi"
                }
            }
        },
        "indico_backend_internal_platform_httpx.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/indico_backend_internal_platform_httpx.ErrorInfo"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "internal_modules_inventory.ConfirmRequest": {
            "type": "object",
            "required": [
                "reservation_id"
            ],
            "properties": {
                "reservation_id": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "res_883291"
                }
            }
        },
        "internal_modules_inventory.ConfirmResponse": {
            "type": "object",
            "properties": {
                "confirmed_at": {
                    "type": "string",
                    "example": "2026-07-20T16:32:00Z"
                },
                "reservation_id": {
                    "type": "string",
                    "example": "res_883291"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "internal_modules_inventory.ReserveRequest": {
            "type": "object",
            "required": [
                "item_id",
                "quantity",
                "user_id"
            ],
            "properties": {
                "item_id": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "item_4021"
                },
                "quantity": {
                    "type": "integer",
                    "maximum": 1000,
                    "example": 2
                },
                "user_id": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "usr_9981"
                }
            }
        },
        "internal_modules_inventory.ReserveResponse": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "string",
                    "example": "2026-07-20T16:35:00Z"
                },
                "item_id": {
                    "type": "string",
                    "example": "item_4021"
                },
                "quantity": {
                    "type": "integer",
                    "example": 2
                },
                "reservation_id": {
                    "type": "string",
                    "example": "res_883291"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "internal_modules_inventory.StockResponse": {
            "type": "object",
            "properties": {
                "available_stock": {
                    "type": "integer",
                    "example": 85
                },
                "item_id": {
                    "type": "string",
                    "example": "item_4021"
                },
                "reserved_stock": {
                    "type": "integer",
                    "example": 15
                },
                "total_stock": {
                    "type": "integer",
                    "example": 100
                }
            }
        }
    }
}