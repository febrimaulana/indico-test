# Copy this file to .env ONLY if you want to override the defaults.
# `docker compose up` works out of the box without any .env file.

# --- Ports on your host machine ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
# 5433 by default: 5432 is commonly taken by a local PostgreSQL installation.
POSTGRES_PORT=5433

# --- Database credentials ---
POSTGRES_USER=indico
POSTGRES_PASSWORD=indico
POSTGRES_DB=indico

# --- Backend behavior ---
LOG_LEVEL=info
